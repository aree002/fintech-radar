# Copy this file to secrets.toml and add your Groq key. Do not commit secrets.toml.
# On Streamlit Community Cloud, set these under the app's Secrets settings instead.
#
# Live scan = DuckDuckGo search (no key) + Groq to summarise. So a Groq key is
# all you need.

# Free, no credit card: https://console.groq.com
GROQ_API_KEY = ""

# Optional: a Tavily key gives more reliable search than DuckDuckGo
# (free tier, no card). https://tavily.com
# TAVILY_API_KEY = ""

# Optional login gate. Set BOTH to require a username and password before the
# app can be used. Leave them unset and the app runs open (fine for local use).
# Set these on Streamlit Community Cloud so only you can run scans with your keys.
# APP_USERNAME = ""
# APP_PASSWORD = ""
